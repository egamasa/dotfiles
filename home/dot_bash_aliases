# Terminal
alias c='clear'
alias h='history'
alias reload='source ~/.bashrc'

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias -- -='cd -'

# System
alias df='df -h'
alias free='free -h'

# Disk usage
alias dua='du -sh ./* 2>/dev/null | sort -rh'
alias dud='du -sh ./*/ 2>/dev/null | sort -rh'

# Files
alias grep='grep --color=auto'

alias ls='ls --color=auto'
alias ll='ls -alhF'
alias la='ls -AF'
alias l='ls -CF'

# Git
alias ga='git add'
alias gb='git branch'
alias gc='git commit'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias gp='git push'
alias gpl='git pull'
alias gs='git status -sb'
alias gsw='git switch'
